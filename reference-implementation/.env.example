# ============================================================================
# SKI Framework Reference Implementation — Configuration
# ============================================================================
# Copy this file to .env and fill in the REQUIRED values. The stack will
# refuse to start if any required variable is missing or set to the default
# placeholder "CHANGE_ME". Use scripts/setup.sh to generate strong secrets
# automatically.
# ============================================================================

# ----------------------------------------------------------------------------
# INFERENCE BACKEND (REQUIRED)
# ----------------------------------------------------------------------------
# SKI_V3_LLM_BACKEND selects the backend. Values:
# "ollama"  — Local LLM runtime (bundled in docker-compose.yml). Conformant.
# "vllm"    — Local vLLM server (OpenAI-compatible API). Conformant.
# "fake"    — Pattern-matching FakeLLM for demos/CI. NOT conformant. It is
#             also what an UNSET backend resolves to, and the runtime refuses
#             to start on it unless SKI_ALLOW_FAKE_LLM=true (below).
# SKI_INFERENCE_BACKEND is accepted as a deprecated alias. If both are set and
# differ, the runtime refuses to start. There is no cloud-API backend.
SKI_V3_LLM_BACKEND=ollama

# Explicit opt-in to run the non-conformant FakeLLM ("fake"). Must be exactly
# "true". Only docker-compose.demo.yml, CI and tests set it. Leave unset.
# SKI_ALLOW_FAKE_LLM=true

# Sovereignty mode (spec §6). "strict" (default) refuses to start unless:
#   1. the backend is ollama or vllm;
#   2. SKI_MODEL_FILE_SHA256 pins the model weights;
#   3. SKI_KG_TRUST_ANCHORS names your own KG-signing keys;
#   4. LEDGER_DSN points inside the deployment;
#   5. the model and ledger hosts are inside the deployment.
# and refuses further evaluation after any network call leaving the
# deployment during an evaluation (ski_egress_attempts_total). "advisory" only
# logs unmet requirements: demos and CI, never production.
SKI_SOVEREIGNTY=strict
# Extra domain suffixes that count as inside the deployment (comma-separated),
# e.g. ".corp.example". Loopback, private IPs, single-label service names and
# .local/.internal/.svc/.cluster.local are always local.
# SKI_SOVEREIGN_LOCAL_DOMAINS=

# Model name. For Ollama, must be a model you've already pulled.
# Recommended starter models (small, open-weights, instruction-tuned):
#   qwen2.5:7b-instruct, mistral:7b-instruct, phi3.5:3.8b-mini-instruct
SKI_MODEL_NAME=qwen2.5:7b-instruct

# Expected SHA-256 of the model WEIGHTS (64 hex chars, optional "sha256:").
# Set it after pulling the model. When set, the runtime refuses to start
# unless it can verify the served weights against it:
#   ollama — the weights blob named by /api/show. Get the value with:
#            docker compose exec ollama ollama show --modelfile "$SKI_MODEL_NAME" | grep '^FROM'
#            (FROM .../blobs/sha256-<hex>: use <hex>). Ollama unreachable, no
#            blob, or a different blob => refuse to start.
#   vllm   — vLLM exposes no digest: also mount the weights file into the
#            ski-model container and set SKI_MODEL_FILE_PATH so it is hashed at
#            boot (mismatch => refuse). Without SKI_MODEL_FILE_PATH the value is
#            recorded as operator-asserted, unverified.
#   fake   — refused (no weights).
# Left empty, /api/health and every verdict report model_hash_verified=false.
SKI_MODEL_FILE_SHA256=
# vLLM only: path INSIDE the ski-model container of a single weights file
# (.gguf or one .safetensors) to hash at boot. Optional.
SKI_MODEL_FILE_PATH=

# Deterministic decoding parameters. Do not change unless you understand the
# determinism implications and have updated the conformance test suite.
SKI_MODEL_SEED=42
SKI_MODEL_MAX_TOKENS=512

# Determinism canary interval (seconds). The service periodically re-runs a
# fixed canary input and verifies the verdict is unchanged.
DETERMINISM_CANARY_INTERVAL=300

# ----------------------------------------------------------------------------
# SKI API AUTHENTICATION (REQUIRED)
# ----------------------------------------------------------------------------
# Generate with:  openssl rand -hex 32
SKI_API_KEY=CHANGE_ME

# ----------------------------------------------------------------------------
# KNOWLEDGE GRAPH (REQUIRED for runtime)
# ----------------------------------------------------------------------------
KG_PATH=/app/kg/kg.json
# The SKI Model refuses to load an unsigned KG by default. Setting this to
# false is permitted only for local demos and disqualifies the deployment
# from all conformance levels. An unsigned KG is reported as
# kg_trust="unsigned" on /api/health and every verdict, and it is refused
# outright while SKI_KG_TRUST_ANCHORS is configured.
KG_REQUIRE_SIGNATURE=true

# KG trust anchors (framework v3.2.0; spec §2.1.2, §3.5) - REQUIRED.
# Path to a PEM bundle of one or more Ed25519 public keys ("-----BEGIN
# PUBLIC KEY-----" blocks; '#' comment lines are allowed). A KG loads only
# if its signature verifies against one of these keys; the public key
# embedded in the KG is never trusted on its own. Key IDs are
# sha256:<hex sha256 of the raw 32-byte public key> and are reported as
# kg_signer_key_id on /api/health and every verdict. An unreadable, empty
# or malformed bundle refuses to start. Several keys = key rotation.
# This is the IN-CONTAINER path; docker-compose.yml mounts the host file
# named by SKI_KG_TRUST_ANCHORS_HOST_FILE there (default: the demo anchor
# written by scripts/make-demo-kg.py). Replace it with your KG Owner's key(s).
# Leaving the value empty means "no anchors": every signed KG is refused
# unless SKI_KG_ALLOW_UNANCHORED=true (dev only).
SKI_KG_TRUST_ANCHORS=/app/trust/kg-trust-anchors.pem
SKI_KG_TRUST_ANCHORS_HOST_FILE=./kg-signing/kg-trust-anchors.pem

# DEV ONLY escape hatch: with NO trust anchors configured, set to true to
# load a KG checked only against its own embedded key. /api/health and every
# verdict then report kg_trust="unanchored" and kg_signature_verified=false.
# Ignored when SKI_KG_TRUST_ANCHORS is set. Non-conformant. Default: false.
SKI_KG_ALLOW_UNANCHORED=false

# Runtime KG hot-load (POST /api/kg/load). Disabled by default. When true,
# the endpoint requires the X-SKI-Admin-Key header to match
# SKI_ADMIN_API_KEY, which MUST differ from SKI_API_KEY (the key the sidecar
# holds); the service refuses to start otherwise. Hot-loaded KGs pass the
# same trust-anchor check as the startup KG.
SKI_ENABLE_KG_HOT_LOAD=false
# Generate with:  openssl rand -hex 32   (only needed with hot-load enabled)
SKI_ADMIN_API_KEY=

# ----------------------------------------------------------------------------
# TRANSCRIPT SIGNING KEY (framework v3.2.0)
# ----------------------------------------------------------------------------
# Ed25519 key that signs every LLM transcript (spec §6.3); raw 32-byte
# private key file. Keep it on a persistent volume and back it up. The
# compose stacks pin this path on their persistent /data volume. The public
# key ID is logged at startup and reported as provenance.transcript_key_id
# on /api/health.
SKI_TRANSCRIPT_KEY_PATH=/data/keys/transcript.ed25519
# A missing key is never silently regenerated. Runtime default: false, so a
# missing key refuses to start. This example sets true so the first
# `docker compose up` after scripts/setup.sh can mint the key; set it back to
# false once the key is backed up. A missing key while the ledger already
# holds signed transcripts refuses to start even when this is true (restore
# the key, or provision a new one deliberately to rotate).
SKI_ALLOW_KEY_GENERATION=true

# ----------------------------------------------------------------------------
# AUDIT LEDGER (PostgreSQL) (REQUIRED)
# ----------------------------------------------------------------------------
# Generate strong values via setup.sh. Defaults are intentionally absent.
# POSTGRES_USER owns the schema and runs the init/migration SQL. The SKI
# Model does NOT use it: it connects as ski_ledger_writer (INSERT + SELECT on
# the ledger, no UPDATE/DELETE/TRUNCATE/ALTER/trigger rights).
POSTGRES_DB=ski_ledger
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
# Login password for the least-privilege ski_ledger_writer role. Set on first
# init by src/ledger/ledger_writer_login.sh. Existing (pre-3.2) volumes: see
# CHANGELOG 3.2.0 for the one-off upgrade commands.
SKI_LEDGER_WRITER_PASSWORD=CHANGE_ME

# ----------------------------------------------------------------------------
# DATA INTEGRATION (SIDECAR)
# ----------------------------------------------------------------------------
# Source for operational telemetry: file (default), http, or kafka
TELEMETRY_SOURCE=file
TELEMETRY_BATCH_SIZE=100
HEARTBEAT_INTERVAL=60

# Kafka — only used when TELEMETRY_SOURCE=kafka. Enable with:
#   docker compose --profile kafka up -d
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=operational-data

# ----------------------------------------------------------------------------
# MONITORING (REQUIRED for Grafana)
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO
GRAFANA_USER=CHANGE_ME
GRAFANA_PASSWORD=CHANGE_ME
GRAFANA_PROTOCOL=https

# pgAdmin — only used with `--profile pgadmin`. Not recommended outside dev.
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# ----------------------------------------------------------------------------
# DEPLOYMENT METADATA
# ----------------------------------------------------------------------------
DEPLOYMENT_NAME=ski-reference-implementation
SECTOR=demo
KG_VERSION=v0.1

# ----------------------------------------------------------------------------
# SECURITY
# ----------------------------------------------------------------------------
# TLS is enabled by default. Self-signed certificates are generated by
# scripts/setup.sh. For production, replace tls/ with certs from your own CA.
TLS_ENABLED=true
API_KEY_REQUIRED=true

# ----------------------------------------------------------------------------
# SERVICE TOGGLES (advanced)
# ----------------------------------------------------------------------------
ENABLE_SIDECAR=true
ENABLE_PROMETHEUS=true
ENABLE_GRAFANA=true

# Resource limits
SKI_MODEL_WORKERS=1   # MUST be 1 — see docs/CONCURRENCY.md
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_MAX_CONNECTIONS=100
