FROM python:3.11-slim

WORKDIR /app

# `upgrade` pulls in pending Debian security updates (the base image
# lags point releases; Trivy gates HIGH/CRITICAL in CI).
RUN apt-get update && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY src/sidecar/requirements.txt .
# Refresh the build tooling baked into the base image: the bundled
# setuptools/wheel carry known CVEs (vendored jaraco.context, wheel)
# that the gating Trivy scan rejects.
RUN pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir -r requirements.txt \
    # ensurepip bundles its own standalone pip/setuptools wheel files
    # (Lib/ensurepip/_bundled/*.whl) at whatever version shipped with
    # this Python point release, independent of the site-packages
    # install above. Trivy's package scanner reads METADATA directly
    # out of those wheels and flags them even though they're never
    # extracted or importable — strip them so only the actually
    # installed (and upgraded) copies remain in the image.
    && find /usr/local/lib/python3.11/ensurepip -name '*.whl' -delete

COPY src/sidecar/ ./sidecar/

RUN useradd --create-home --shell /bin/false --uid 10002 ski && \
    chown -R ski:ski /app
USER ski

EXPOSE 8001

CMD ["python", "-m", "sidecar.main"]
