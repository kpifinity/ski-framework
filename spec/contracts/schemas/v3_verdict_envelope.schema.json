{
  "$defs": {
    "FormalizableAssertion": {
      "additionalProperties": false,
      "description": "A structured assertion the symbolic verifier can mechanically check.",
      "properties": {
        "metric": {
          "description": "Dotted-path into the measurement object.",
          "title": "Metric",
          "type": "string"
        },
        "obligation_id": {
          "description": "The KG obligation this assertion checks.",
          "title": "Obligation Id",
          "type": "string"
        },
        "observed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "items": {},
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed"
        },
        "predicate": {
          "description": "Predicate type, e.g. 'must_not_exceed'.",
          "title": "Predicate",
          "type": "string"
        },
        "satisfied": {
          "title": "Satisfied",
          "type": "boolean"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "items": {},
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "window_seconds": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Time-window length in seconds for stateful predicates (e.g. 86400 for a 24h rolling average). None for stateless predicates.",
          "title": "Window Seconds"
        }
      },
      "required": [
        "predicate",
        "metric",
        "satisfied",
        "obligation_id"
      ],
      "title": "FormalizableAssertion",
      "type": "object"
    },
    "KGCitation": {
      "additionalProperties": false,
      "description": "A single KG node the LLM cited as informing the verdict.",
      "properties": {
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/KGCitationRole"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "version",
        "role"
      ],
      "title": "KGCitation",
      "type": "object"
    },
    "KGCitationRole": {
      "description": "The role a cited KG node played in the verdict.",
      "enum": [
        "obligation",
        "definition_resolved",
        "exemption_considered",
        "precedent_referenced",
        "jurisdiction_matched"
      ],
      "title": "KGCitationRole",
      "type": "string"
    },
    "ModelProvenance": {
      "additionalProperties": false,
      "description": "Inference provenance metadata required for v3 replay.\n\nAll hash values MUST be lowercase hex prefixed with ``sha256:`` per\nspec §4.6. The Pydantic layer enforces the prefix.",
      "properties": {
        "decoder_seed": {
          "minimum": 0,
          "title": "Decoder Seed",
          "type": "integer"
        },
        "inference_backend": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name of the backend that produced the verdict, e.g. 'ollama-v3', 'fake-llm'.",
          "title": "Inference Backend"
        },
        "kg_signer_key_id": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Key ID of the Ed25519 key the Knowledge Graph signature verified against: 'sha256:' + hex sha256 of the raw 32-byte public key. None when the KG was unsigned.",
          "title": "Kg Signer Key Id"
        },
        "kg_trust": {
          "anyOf": [
            {
              "enum": [
                "anchored",
                "unanchored",
                "unsigned"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "'anchored': the KG signature verified against an operator-pinned trust anchor (SKI_KG_TRUST_ANCHORS). 'unanchored': no anchors, SKI_KG_ALLOW_UNANCHORED=true, checked only against the KG's own embedded key (dev only). 'unsigned': KG_REQUIRE_SIGNATURE=false loaded a KG with no signature (dev only).",
          "title": "Kg Trust"
        },
        "kg_version_hash": {
          "pattern": "^sha256:[0-9a-f]+$",
          "title": "Kg Version Hash",
          "type": "string"
        },
        "model_hash_verified": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "True only when an operator pin (SKI_MODEL_FILE_SHA256) matched a weights digest the runtime obtained independently of that pin. False means model_weight_hash is unverified: an unpinned backend digest, an operator-asserted value, or a name commitment that is NOT a weight hash.",
          "title": "Model Hash Verified"
        },
        "model_weight_hash": {
          "pattern": "^sha256:[0-9a-f]+$",
          "title": "Model Weight Hash",
          "type": "string"
        },
        "prompt_template_hash": {
          "pattern": "^sha256:[0-9a-f]+$",
          "title": "Prompt Template Hash",
          "type": "string"
        },
        "prompt_template_id": {
          "description": "Stable id, e.g. 'ski.v3.evaluate.1'.",
          "title": "Prompt Template Id",
          "type": "string"
        },
        "structured_grammar_hash": {
          "pattern": "^sha256:[0-9a-f]+$",
          "title": "Structured Grammar Hash",
          "type": "string"
        }
      },
      "required": [
        "model_weight_hash",
        "kg_version_hash",
        "prompt_template_id",
        "prompt_template_hash",
        "decoder_seed",
        "structured_grammar_hash"
      ],
      "title": "ModelProvenance",
      "type": "object"
    },
    "V3Verdict": {
      "description": "The five-verdict taxonomy, preserved from v2.1.",
      "enum": [
        "CLEAR",
        "FLAG",
        "NULL_UNMAPPED",
        "NULL_STALE",
        "DISCRETIONARY"
      ],
      "title": "V3Verdict",
      "type": "string"
    },
    "VerifierResult": {
      "additionalProperties": false,
      "description": "The symbolic verifier's per-assertion result.",
      "properties": {
        "checked_assertions": {
          "default": 0,
          "minimum": 0,
          "title": "Checked Assertions",
          "type": "integer"
        },
        "divergences": {
          "items": {
            "type": "string"
          },
          "title": "Divergences",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/VerifierStatus"
        }
      },
      "required": [
        "status"
      ],
      "title": "VerifierResult",
      "type": "object"
    },
    "VerifierStatus": {
      "description": "Status returned by the Symbolic Verifier (spec §5.3).",
      "enum": [
        "AGREED",
        "LLM_CONTRADICTION",
        "NEURO_SYMBOLIC_DIVERGENCE",
        "UNVERIFIABLE"
      ],
      "title": "VerifierStatus",
      "type": "string"
    }
  },
  "$id": "https://kpifinity.github.io/ski-framework/contracts/schemas/v3_verdict_envelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The complete v3 verdict envelope.\n\nEvery required field is enforced at the Pydantic layer. The\nenvelope MUST round-trip through JSON without loss; that property\nis what makes the audit ledger's hash chain meaningful.",
  "properties": {
    "formalizable_assertions": {
      "items": {
        "$ref": "#/$defs/FormalizableAssertion"
      },
      "title": "Formalizable Assertions",
      "type": "array"
    },
    "human_attestation": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Human Attestation"
    },
    "kg_citations": {
      "items": {
        "$ref": "#/$defs/KGCitation"
      },
      "title": "Kg Citations",
      "type": "array"
    },
    "model_provenance": {
      "$ref": "#/$defs/ModelProvenance"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "reasoning": {
      "title": "Reasoning",
      "type": "string"
    },
    "transcript_ref": {
      "description": "Pointer to the LLM transcript in the ledger.",
      "title": "Transcript Ref",
      "type": "string"
    },
    "verdict": {
      "$ref": "#/$defs/V3Verdict"
    },
    "verdict_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Per §5.6: 'fast' or None.",
      "title": "Verdict Path"
    },
    "verifier_result": {
      "$ref": "#/$defs/VerifierResult"
    }
  },
  "required": [
    "verdict",
    "reasoning",
    "verifier_result",
    "model_provenance",
    "transcript_ref"
  ],
  "title": "V3VerdictEnvelope",
  "type": "object"
}
